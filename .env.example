# Which Arc network the app uses: "mainnet" for Arc mainnet (real USDC), anything else for Arc Testnet. See docs/mainnet-deploy.md.
VITE_CLIMB_NETWORK=
# Address of the deployed ClimbEscrow contract on that network (public).
VITE_CLIMB_ESCROW_ADDRESS=
# Block the contract was deployed at (public, optional). Lets the app read history without scanning from block 0.
VITE_CLIMB_DEPLOY_BLOCK=

# Pinata JWT used by the /api/upload route to pin claim images to IPFS. SERVER-SIDE ONLY.
# Get one at https://app.pinata.cloud/developers/api-keys : create a key with the "Files: Write" permission
# and copy the JWT. Never prefix it with VITE_ (that would ship it to the browser).
# On Vercel, add it under Project Settings > Environment Variables.
PINATA_JWT=

# Shared rate-limit store for /api/upload (10 uploads per wallet and 20 per IP per hour).
# Create a free Upstash Redis database (Vercel Marketplace > Upstash Redis adds these automatically) and copy its REST URL and token.
# Server-side only. Without them, limits only hold per serverless instance, which is weaker.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
